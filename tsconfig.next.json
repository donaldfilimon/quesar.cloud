{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    // Next's asset module types without the generated next-env.d.ts (fresh clones).
    "types": ["node", "next", "next/image-types/global"]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "proxy.server.ts",
    "app",
    "src",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "src/**/*.test.ts", "src/**/*.test.tsx", "src/framework/assets.d.ts"]
}
