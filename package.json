{
  "name": "quesar-cloud",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build && node scripts/copy-pglite-assets.ts && node scripts/migrate.ts",
    "build:static": "VITE_STATIC_SITE=true VITE_AUTH_ENABLED=false vite build --mode static && node scripts/publish-static.ts",
    "db:migrate": "node scripts/migrate.ts",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write ."
  },
