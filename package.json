{
  "name": "quesar-cloud",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "routes": "node scripts/next-routes.ts",
    "dev": "node scripts/next-routes.ts && QUESAR_NEXT_MODE=server next dev --webpack --hostname 0.0.0.0 --port 8080",
    "build": "node scripts/next-routes.ts --check && QUESAR_NEXT_MODE=server next build --webpack",
    "build:persistent": "node scripts/next-routes.ts --check && QUESAR_NEXT_MODE=server QUESAR_NEXT_PERSISTENT=true next build --webpack",
    "build:static": "node scripts/next-routes.ts --check && next build --webpack && node scripts/next-export.ts && node scripts/publish-static.ts",
    "export:research-site": "bun scripts/export-research-site.tsx",
    "db:migrate": "node scripts/migrate.ts",
    "start": "QUESAR_NEXT_MODE=server next start --hostname 127.0.0.1 --port 8081",
    "preview": "bun run start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.next.json && tsc --noEmit -p tsconfig.migration.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:static": "node scripts/check-static.ts",
    "check:parity": "node scripts/next-check.ts",
    "check:research-drift": "node scripts/research-drift.ts",
    "og:images": "node scripts/og-images.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@better-auth/core": "1.7.6",
    "@better-auth/passkey": "1.7.6",
    "@electric-sql/pglite": "^0.5.4",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hookform/resolvers": "^5.7.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tensorflow-models/posenet": "^2.2.2",
    "@tensorflow/tfjs": "^4.22.0",
    "better-auth": "~1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "katex": "^0.18.9",
    "kysely": "^0.29.6",
    "lucide-react": "^1.48.0",
    "next": "16.4.3",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3",
    "seroval": "1.6.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "7.29.8",
    "@eslint/js": "^10",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.5",
    "globals": "^17",
    "jiti": "2.7.0",
    "lightningcss": "^1.28.0",
    "magic-string": "1.4.2",
    "parse5": "^8.0.1",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.2"
  }
}
