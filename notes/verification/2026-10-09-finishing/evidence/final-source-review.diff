+    expect((await response.json()).job.id).not.toBe(original.job.id);
+  } finally {
+    child.kill();
+    await child.exited;
+    reader.releaseLock();
+    try { await server?.shutdown(); }
+    finally { await rm(home, { recursive: true, force: true }); }
+  }
+});
