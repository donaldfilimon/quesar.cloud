neural-delay:1.22s;--neural-opacity:0.79"></circle><circle class="neural-field-node neural-field-node-inner" cx="258.61" cy="340.62" r="2.40" style="--neural-delay:1.34s;--neural-opacity:0.79"></circle><circle class="neural-field-node neural-field-node-inner" cx="218.45" cy="295.79" r="3.40" style="--neural-delay:1.21s;--neural-opacity:0.79"></circle><circle class="neural-field-node neural-field-node-inner" cx="201.32" cy="240.27" r="2.40" style="--neural-delay:1.31s;--neural-opacity:0.79"></circle><circle class="neural-field-node neural-field-node-inner" cx="233.31" cy="201.01" r="2.40" style="--neural-delay:1.25s;--neural-opacity:0.79"></circle><circle class="neural-field-node neural-field-node-inner" cx="297.11" cy="179.38" r="3.40" style="--neural-delay:1.33s;--neural-opacity:0.79"></circle><circle class="neural-field-node neural-field-node-inner" cx="349.25" cy="224.21" r="2.40" style="--neural-delay:1.28s;--neural-opacity:0.79"></circle></g><g class="neural-field-core"><circle class="neural-field-core-halo" cx="280" cy="260" r="18"></circle><circle class="neural-field-core-ring" cx="280" cy="260" r="10"></circle><circle cx="280" cy="260" r="4.5"></circle><circle class="neural-field-core-center" cx="279" cy="259" r="1.8"></circle></g></svg></div></div></div><div class="relative mx-auto flex max-w-6xl flex-wrap gap-x-8 gap-y-2 border-t border-white/10 px-4 py-5 text-sm sm:px-6"><a href="#ecosystem" class="vision-section-link inline-flex min-h-11 items-center">Explore the ecosystem ↓</a><a href="#film" class="vision-section-link inline-flex min-h-11 items-center">Watch the film ↓</a><a class="vision-section-link inline-flex min-h-11 items-center" href="/developers">Build with MLAI →</a></div></section><section class="vision-belief border-b border-border" aria-labelledby="belief-title"><div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-24"><h2 id="belief-title" class="font-display text-3xl leading-tight tracking-tight sm:text-4xl">AI should amplify human creativity.</h2><p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-fg-muted">Our direction is to help people learn, build, reason, and create while keeping human agency at the center.</p></div></section><section id="ecosystem" aria-labelledby="ecosystem-title" class="scroll-mt-20 border-b border-border"><div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-24"><header class="max-w-3xl"><p class="eyebrow">The MLAI ecosystem</p><h2 id="ecosystem-title" class="section-title mt-4">Distinct roles. One inspectable architecture.</h2><p class="mt-5 max-w-[52ch] text-base leading-relaxed text-fg-muted">Abbey, Aviva, and Abi are persona roles in ABI. WDBX supplies the memory substrate. Read each implementation boundary before integrating.</p></header><div class="min-w-0"><div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4"><article class="vision-product vision-product-abbey"><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-current" title="Present in public source and used as described."><span aria-hidden="true">●</span>Current</span><h3 class="mt-6 font-display text-3xl tracking-tight">Abbey</h3><p class="vision-product-role mt-2 text-sm font-medium">Human-facing companion</p><p class="mt-5 text-base leading-relaxed text-fg-muted">Designed for thoughtful teaching, creative work, and technical collaboration.</p><p class="mt-4 text-sm leading-relaxed text-fg-subtle">A persona contract; assistant behavior depends on the configured backend.</p><a class="mt-6 inline-flex min-h-11 items-center text-sm font-medium text-accent" href="/abbey">Explore <!-- -->Abbey<!-- --> →</a></article><article class="vision-product vision-product-aviva"><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-current" title="Present in public source and used as described."><span aria-hidden="true">●</span>Current</span><h3 class="mt-6 font-display text-3xl tracking-tight">Aviva</h3><p class="vision-product-role mt-2 text-sm font-medium">Direct expert mode</p><p class="mt-5 text-base leading-relaxed text-fg-muted">A response mode for concise, candid technical answers, concrete next actions, and explicit uncertainty.</p><p class="mt-4 text-sm leading-relaxed text-fg-subtle">A local persona profile; the role does not establish model quality.</p><a class="mt-6 inline-flex min-h-11 items-center text-sm font-medium text-accent" href="/abi">Explore <!-- -->Aviva<!-- --> →</a></article><article class="vision-product vision-product-abi"><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-partial" title="Implemented in part. Scope is named on the page."><span aria-hidden="true">◐</span>Partial</span><h3 class="mt-6 font-display text-3xl tracking-tight">Abi</h3><p class="vision-product-role mt-2 text-sm font-medium">Coordination layer</p><p class="mt-5 text-base leading-relaxed text-fg-muted">Evaluates intent, risk, context, and response style to select a persona or controlled blend.</p><p class="mt-4 text-sm leading-relaxed text-fg-subtle">Local routing and scheduler helpers; broader governance remains partial.</p><a class="mt-6 inline-flex min-h-11 items-center text-sm font-medium text-accent" href="/abi">Explore <!-- -->Abi<!-- --> →</a></article><article class="vision-product vision-product-wdbx"><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-current" title="Present in public source and used as described."><span aria-hidden="true">●</span>Current</span><h3 class="mt-6 font-display text-3xl tracking-tight">WDBX</h3><p class="vision-product-role mt-2 text-sm font-medium">Memory with provenance</p><p class="mt-5 text-base leading-relaxed text-fg-muted">Local Rust storage and retrieval components preserve durable records, vectors, and causal history.</p><p class="mt-4 text-sm leading-relaxed text-fg-subtle">Storage integrity does not make a statement true; production multi-host deployment is not established.</p><a class="mt-6 inline-flex min-h-11 items-center text-sm font-medium text-accent" href="/wdbx">Explore <!-- -->WDBX<!-- --> →</a></article></div><figure class="vision-architecture mt-12 rounded-lg border border-border bg-bg-elevated p-6 sm:p-8"><ol class="grid gap-6 sm:grid-cols-3" aria-label="Conceptual request flow"><li class="font-display text-xl"><span class="mb-2 block font-mono text-xs text-fg-subtle">0<!-- -->1</span>Your context</li><li class="font-display text-xl"><span class="mb-2 block font-mono text-xs text-fg-subtle">0<!-- -->2</span>ABI routing</li><li class="font-display text-xl"><span class="mb-2 block font-mono text-xs text-fg-subtle">0<!-- -->3</span>Selected persona</li></ol><div class="mt-6 border-t border-border pt-5 text-base"><span class="font-medium text-accent">WDBX</span><span class="ml-3 text-fg-muted">Context and storage · writes report their result</span></div><figcaption class="mt-4 text-sm leading-relaxed text-fg-subtle">Conceptual architecture. Persona roles share a runtime; this diagram does not establish separate models or hosted services.</figcaption><a class="mt-4 inline-flex min-h-11 items-center text-sm font-medium text-accent" href="/architecture">Inspect the architecture →</a><div class="mt-4 flex flex-wrap gap-x-5 gap-y-1" aria-label="Pinned ecosystem sources"><a href="https://github.com/donaldfilimon/abi/blob/80dfe079ebe7413a6815c2d564be1f0aaa901267/crates/abi-ai/src/identity.rs" class="inline-flex min-h-11 items-center text-xs text-accent underline underline-offset-4">ABI persona contracts</a><a href="https://github.com/donaldfilimon/abi/blob/80dfe079ebe7413a6815c2d564be1f0aaa901267/README.md" class="inline-flex min-h-11 items-center text-xs text-accent underline underline-offset-4">ABI setup and limits</a><a href="https://github.com/donaldfilimon/wdbx/blob/e45410356ceb4e96f0dc26a83b02e1c18cf94860/README.md" class="inline-flex min-h-11 items-center text-xs text-accent underline underline-offset-4">WDBX implementation</a><a href="https: