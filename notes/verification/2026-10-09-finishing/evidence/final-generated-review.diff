status=active]:text-fg" href="/contact">Contact</a><button type="button" aria-haspopup="menu" aria-expanded="false" data-state="closed" class="nav-link rounded-sm px-2.5 py-2 text-sm no-underline transition-[color,background-color] duration-150 text-fg-muted hover:text-fg" data-overlay-trigger="more">More</button></nav><div class="flex shrink-0 items-center sm:gap-1"><button type="button" class="inline-flex h-11 items-center gap-2 rounded-md px-2.5 text-fg-muted hover:bg-bg-subtle hover:text-fg" aria-label="Search the site" aria-haspopup="dialog" aria-expanded="false" data-state="closed" data-overlay-trigger="search"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search size-4" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><span class="hidden text-xs xl:inline">Search</span><kbd class="hidden rounded-sm bg-bg-subtle px-1.5 py-0.5 font-mono text-2xs text-fg-subtle xl:inline">⌘K</kbd></button><span class="hidden h-11 items-center px-3 text-xs whitespace-nowrap text-fg-subtle sm:inline-flex" title="Static preview: sign-in runs on the server deployment">Static preview</span><button type="button" aria-pressed="true" data-state="closed" class="size-11 items-center justify-center rounded-md text-fg-muted hover:bg-bg-subtle hover:text-fg data-[state=on]:text-fg hidden sm:inline-flex" aria-label="Dark theme" data-overlay-trigger="_R_ul6_"><span class="relative size-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sun absolute inset-0 size-4 transition-[opacity,transform,filter] duration-250 ease-[cubic-bezier(0.22,1,0.36,1)] scale-[0.25] opacity-0 blur-[4px]" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon absolute inset-0 size-4 transition-[opacity,transform,filter] duration-250 ease-[cubic-bezier(0.22,1,0.36,1)] scale-100 opacity-100 blur-0" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path></svg></span></button><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="inline-flex size-11 items-center justify-center rounded-md text-fg lg:hidden" data-overlay-trigger="menu"><span class="sr-only">Open menu</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu size-5" aria-hidden="true"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"></path></svg></button></div></div></header><main id="main" tabindex="-1" class="flex-1"><!--$--><div class="border-b border-border"><div class="mx-auto max-w-6xl px-4 pt-16 pb-14 sm:px-6 sm:pt-24 sm:pb-20"><p class="eyebrow">Services</p><h1 class="mt-5 max-w-4xl font-display text-4xl leading-[1.02] tracking-tight text-fg sm:text-5xl lg:text-6xl">Choose the next engineering decision.</h1><p class="mt-6 max-w-[62ch] text-lg leading-8 text-fg-muted">Start with assessment, build a bounded workflow, or harden a release path. The service catalog proposes concrete deliverables for retrieval, orchestration, deployment, and evaluation engagements.</p></div></div><section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28"><p class="max-w-3xl text-base leading-relaxed text-fg-muted">Engagement scope, deliverables, and acceptance criteria are agreed for each project.</p><a href="https://github.com/donaldfilimon/quesar.cloud/blob/f3ccc082f72ef868ca3c3a60f332f7efe9cfe492/src/lib/mlai/categories/services.ts" target="_blank" rel="noreferrer" class="mt-4 inline-block text-sm text-accent underline underline-offset-4">Inspect the source behind this page</a></section><section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28"><div id="engagements" class="scroll-mt-28"><p class="eyebrow">Work with MLAI</p><h2 class="mt-4 max-w-3xl font-display text-3xl tracking-tight sm:text-5xl">Turn your next system into something inspectable.</h2><p class="mt-5 max-w-2xl text-base leading-relaxed text-fg-muted">Start with a defined engineering scope. Agree deliverables, access, and acceptance criteria before work begins.</p><div class="mt-10 grid gap-6 md:grid-cols-2"><article class="rounded-xl border border-accent/40 bg-bg-elevated p-6 sm:p-8"><p class="eyebrow">Pilot engagement</p><h3 class="mt-4 font-display text-4xl tracking-tight">$2,500 <span class="text-base text-fg-muted">USD / one month</span></h3><p class="mt-5 text-base leading-relaxed text-fg-muted">A scoped engineering engagement for an AI workflow, retrieval path, or private deployment. Scope and delivery dates are agreed with you.</p><ul class="mt-5 space-y-3 text-sm text-fg-muted"><li>Agreed deliverables and acceptance criteria</li><li>One month, with no automatic renewal</li><li>Invoiced engagement; hosted model access is not included</li></ul><a class="mt-7 inline-flex min-h-11 items-center rounded-full bg-accent px-6 text-sm font-medium text-bg" href="/contact?service=Pilot+engineering+engagement">Discuss the Pilot →</a><div class="mt-4"><div class="rounded-lg border border-border bg-bg-elevated p-4 " role="note"><p class="text-xs text-accent">Static preview</p><p class="mt-2 text-sm leading-relaxed text-fg-muted">Online invoice requests<!-- --> requires the server deployment, which is not live here.</p></div><p class="mt-4 text-sm leading-relaxed text-fg-muted">Contact us to agree the scope and arrange an invoice. Online payment collection is not available on this site.</p></div></article><article class="rounded-xl border border-border bg-card p-6 sm:p-8"><p class="eyebrow">Platform engagement</p><h3 class="mt-4 font-display text-4xl tracking-tight">Built around your scope.</h3><p class="mt-5 text-base leading-relaxed text-fg-muted">For larger integration, hardening, and deployment work, define the architecture and delivery milestones together. Pricing follows the agreed scope.</p><ul class="mt-5 space-y-3 text-sm text-fg-muted"><li>Architecture and integration planning</li><li>Operational and security acceptance criteria</li><li>Custom pricing and invoicing</li></ul><a class="mt-7 inline-flex min-h-11 items-center text-sm font-medium text-accent" href="/contact?service=Platform+engineering+engagement">Discuss a Platform engagement →</a></article></div></div></section><section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28"><header class="mb-12 max-w-3xl"><p class="eyebrow">Core</p><h2 class="section-title mt-4 text-fg">Nine proposed engagement scopes.</h2></header><div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3"><article class="surface accent-edge p-6 flex h-full flex-col"><h3 class="font-display text-xl">Autonomy Readiness Audit</h3><p class="mt-2 flex-1 text-sm leading-relaxed text-fg-muted">Proposed scope: map workflows, prompt surfaces, data paths, and approval gates to identify automation candidates and the evidence needed to evaluate their risks.</p><ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-fg-muted"><li>Risk register</li><li>Control-map</li><li>90-day rollout plan</li></ul><a class="mt-5 inline-flex items-center gap-2 border-t border-border pt-4 text-sm text-accent no-underline hover:underline" href="/contact?service=Autonomy+Readiness+Audit">Discuss this service <span aria-hidden="true">→</span></a></article><article class="surface accent-edge p-6 flex h-full flex-col"><h3 class="font-display text-xl">WDBX Retrieval Architecture</h3><p class="mt-2 flex-1 text-sm leading-relaxed text-fg-muted">Proposed scope: design retrieval pipelines with source context and inspectable vector search; evaluate weighted backtrace approaches separately.</p><ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-fg-muted"><li>Index strategy</li><li>Recall benchmarks</li><li>Trace schema</li></ul><a class="mt-5 inline-flex items-center gap-2 border-t border-border pt-4 text-sm text-accent no-underline hover:underline" href="/contact?service=WDBX+Retrieval+Architecture">Discuss this service <span aria-hidden="true">→</span></a></article><article class="surface accent-edge p-6 flex h-full flex-col"><h3 class="font-display text-xl">Multi-Agent Orchestration</h3><p class="mt-2 flex-1 text-sm leading-relaxed text-fg-muted">Proposed scope: define and implement agent roles, tool permissions, task handoffs, and conflict-resolution policies against agreed acceptance criteria.</p><ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-fg-muted"><li>Agent graph</li><li>Tool policy</li><li>Evaluation harness</li></ul><a class="mt-5 inline-flex items-center gap-2 border-t border-border pt-4 text-sm text-accent no-underline hover:underline" href="/contact?service=Multi-Agent+Orchestration">Discuss this service <span aria-hidden="true">→</span></a></article><article class="surface accent-edge p-6 flex h-full flex-col"><h3 class="font-display text-xl">Model &amp; Runtime Optimization</h3><p class="mt-2 flex-1 text-sm leading-relaxed text-fg-muted">Proposed scope: profile inference paths, memory pressure, batching, and edge constraints on an agreed workload and environment.</p><ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-fg-muted"><li>Latency profile</li><li>Optimization backlog</li><li>Capacity model</li></ul><a class="mt-5 inline-flex items-center gap-2 border-t border-border pt-4 text-sm text-accent no-underline hover:underline" href="/contact?service=Model+%26+Runtime+Optimization">Discuss this service <span aria-hidden="true">→</span></a></article><article class="surface accent-edge p-6 flex h-full flex-col"><h3 class="font-display text-xl">Safety &amp; Compliance Layering</h3><p class="mt-2 flex-1 text-sm leading-relaxed text-fg-muted">Proposed scope: develop policy checks, audit trails, and red-team scenarios for an agreed system boundary. Legal or compliance acceptance requires separate review.</p><ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-fg-muted"><li>Policy matrix</li><li>Audit events</li><li>Red-team scripts</li></ul><a class="mt-5 inline-flex items-center gap-2 border-t border-border pt-4 text-sm text-accent no-underline hover:underline" href="/contact?service=Safety+%26+Compliance+Layering">Discuss this service <span aria-hidden="true">→</span></a></article><article class="surface accent-edge p-6 flex h-full flex-col"><h3 class="font-display text-xl">Private AI Deployment</h3><p class="mt-2 flex-1 text-sm leading-relaxed text-fg-muted">Proposed scope: assess and package workflows for an agreed VPC, on-premise, offline, or hybrid deployment boundary.</p><ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-fg-muted"><li>Deployment topology</li><li>Runbook</li><li>Rollback plan</li></ul><a class="mt-5 inline-flex items-center gap-2 border-t border-border pt-4 text-sm text-accent no-underline hover:underline" href="/contact?service=Private+AI+Deployment">Discuss this service <span aria-hidden="true">→</span></a></article><article class="surface accent-edge p-6 flex h-full flex-col"><h3 class="font-display text-xl">Research Translation</h3><p class="mt-2 flex-1 text-sm leading-relaxed text-fg-muted">Proposed scope: translate papers and notebooks into a constrained prototype, API contract, and test plan.</p><ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-fg-muted"><li>Prototype hardening</li><li>API contract</li><li>Test plan</li></ul><a class="mt-5 inline-flex items-center gap-2 border-t border-border pt-4 text-sm text-accent no-underline hover:underline" href="/contact?service=Research+Translation">Discuss this service <span aria-hidden="true">→</span></a></article><article class="surface accent-edge p-6 flex h-full flex-col"><h3 class="font-display text-xl">Executive &amp; Engineering Workshops</h3><p class="mt-2 flex-1 text-sm leading-relaxed text-fg-muted">Proposed scope: run workshops with leadership, security, product, and engineering to document autonomy decisions and risk boundaries.</p><ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-fg-muted"><li>Decision memo</li><li>Team training</li><li>Architecture review</li></ul><a class="mt-5 inline-flex items-center gap-2 border-t border-border pt-4 text-sm text-accent no-underline hover:underline" href="/contact?service=Executive+%26+Engineering+Workshops">Discuss this service <span aria-hidden="true">→</span></a></article><article class="surface accent-edge p-6 flex h-full flex-col"><h3 class="font-display text-xl">Continuous Evaluation Systems</h3><p class="mt-2 flex-1 text-sm leading-relaxed text-fg-muted">Proposed scope: build evaluation suites for tool use, retrieval faithfulness, policy behavior, and regression drift against agreed criteria.</p><ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-fg-muted"><li>Eval suite</li><li>Scorecards</li><li>Release gates</li></ul><a class="mt-5 inline-flex items-center gap-2 border-t border-border pt-4 text-sm text-accent no-underline hover:underline" href="/contact?service=Continuous+Evaluation+Systems">Discuss this service <span aria-hidden="true">→</span></a></article></div></section><section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28"><header class="mb-12 max-w-3xl"><p class="eyebrow">Proposed engagement process</p><h2 class="section-title mt-4 text-fg">Define the release evidence together.</h2><p class="mt-5 max-w-2xl text-base leading-relaxed text-fg-muted sm:text-lg">These four proposed phases identify deliverables to agree for each project: a register, a harness, a baseline, and acceptance criteria.</p></header><ol class="grid gap-4 md:grid-cols-2"><li class="surface flex gap-4 p-5"><span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-bg font-mono text-2xs text-accent shadow-border">01</span><div><h3 class="font-display text-xl">Audit</h3><p class="mt-2 text-sm leading-relaxed text-fg-muted">Proposed deliverable: an inventory of workflows, data, tools, and failure modes, with a risk register for review before design.</p></div></li><li class="surface flex gap-4 p-5"><span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-bg font-mono text-2xs text-accent shadow-border">02</span><div><h3 class="font-display text-xl">Design</h3><p class="mt-2 text-sm leading-relaxed text-fg-muted">Proposed deliverables: a bounded architecture for retrieval, permissions, personas, and deployment, plus an agreed evaluation harness.</p></div></li><li class="surface flex gap-4 p-5"><span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-bg font-mono text-2xs text-accent shadow-border">03</span><div><h3 class="font-display text-xl">Build</h3><p class="mt-2 text-sm leading-relaxed text-fg-muted">Proposed deliverables: an implementation on agreed operator-owned hardware and a baseline the team can rerun against the harness.</p></div></li><li class="surface flex gap-4 p-5"><span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-bg font-mono text-2xs text-accent shadow-border">04</span><div><h3 class="font-display text-xl">Harden</h3><p class="mt-2 text-sm leading-relaxed text-fg-muted">Proposed deliverables: red-team checks, rollback guidance, observability, operator training, and a release gate with explicit acceptance criteria.</p></div></li></ol></section><section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28"><header class="mb-12 max-w-3xl"><p class="eyebrow">Fit</p><h2 class="section-title mt-4 text-fg">What we say no to.</h2></header><div class="grid gap-4 md:grid-cols-2"><aside class="surface accent-edge p-5 [--edge:var(--accent)]"><p class="text-xs text-accent">Scope discipline</p><p class="mt-2 text-sm leading-relaxed text-fg-muted">Proposed engagement boundary: agree who may access the corpus, where it may move, and which provider calls require approval before implementation.</p></aside><aside class="surface accent-edge p-5 [--edge:var(--accent)]"><p class="text-xs text-accent">Claims discipline</p><p class="mt-2 text-sm leading-relaxed text-fg-muted">Proposed evidence requirement: deliverables should tag figures as targets, source reports, or measurements. Measurements require an agreed workload, environment, and reproduction record.</p></aside></div><div class="mt-8 flex flex-wrap gap-3"><a class="inline-flex items-center justify-center gap-2 border border-transparent font-medium whitespace-nowrap no-underline transition-[background-color,color,box-shadow,opacity,transform] duration-150 ease-out select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:pointer-events-none disabled:opacity-50 active:not-disabled:translate-y-px bg-primary text-primary-foreground hover:bg-primary/80 h-11 rounded-md px-4 text-sm" href="/contact">Discuss your project</a><a class="inline-flex items-center justify-center gap-2 border font-medium whitespace-nowrap no-underline transition-[background-color,color,box-shadow,opacity,transform] duration-150 ease-out select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:pointer-events-none disabled:opacity-50 active:not-disabled:translate-y-px border-border bg-ca