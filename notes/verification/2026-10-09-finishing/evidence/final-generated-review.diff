4 transition-[opacity,transform,filter] duration-250 ease-[cubic-bezier(0.22,1,0.36,1)] scale-[0.25] opacity-0 blur-[4px]" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon absolute inset-0 size-4 transition-[opacity,transform,filter] duration-250 ease-[cubic-bezier(0.22,1,0.36,1)] scale-100 opacity-100 blur-0" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path></svg></span></button><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="inline-flex size-11 items-center justify-center rounded-md text-fg lg:hidden" data-overlay-trigger="menu"><span class="sr-only">Open menu</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu size-5" aria-hidden="true"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"></path></svg></button></div></div></header><main id="main" tabindex="-1" class="flex-1"><!--$--><div class="border-b border-border"><div class="mx-auto max-w-6xl px-4 pt-16 pb-14 sm:px-6 sm:pt-24 sm:pb-20"><p class="eyebrow">Research</p><h1 class="mt-5 max-w-4xl font-display text-4xl leading-[1.02] tracking-tight text-fg sm:text-5xl lg:text-6xl">Ideas with their evidence attached.</h1><p class="mt-6 max-w-[62ch] text-lg leading-8 text-fg-muted">Six tracks, the public notes on each, and the nested implementation cases that pin those claims to source. Citations stay on the page. Borrowed benchmarks do not.</p></div></div><section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28"><header class="mb-12 max-w-3xl"><p class="eyebrow">Tracks</p><h2 class="section-title mt-4 text-fg">Start from the subject, not a paper pile.</h2><p class="mt-5 max-w-2xl text-base leading-relaxed text-fg-muted sm:text-lg">Six research areas, from AI assistance and durable memory to evidence selection and integration. Start with practical applications, then inspect the sources, implementation status, and limitations.</p></header><p class="-mt-6 mb-8 text-sm text-fg-muted">Put these ideas in context:<!-- --> <a class="text-accent" href="/products">explore ABI, Abbey, WDBX and Quasar</a>, or<!-- --> <a class="text-accent" href="/get-started">choose a starting point</a>.</p><div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3"><a class="no-underline" href="/research/ai-overview"><article class="surface accent-edge p-6 surface-hover h-full"><div class="flex items-start justify-between gap-3"><div><p class="text-xs text-fg-subtle">ai</p><h3 class="font-display text-xl mt-1">AI &amp; agent behavior</h3></div></div><p class="mt-2 text-sm leading-relaxed text-fg-muted">Understand how Abbey and ABI route requests, produce local responses, and expose bounded checks.</p><p class="mt-3 text-xs text-fg-subtle">Local deterministic routing and completion are implemented; model quality requires separate evaluation.</p></article></a><a class="no-underline" href="/research/wdbx-overview"><article class="surface accent-edge p-6 surface-hover h-full"><div class="flex items-start justify-between gap-3"><div><p class="text-xs text-fg-subtle">wdbx</p><h3 class="font-display text-xl mt-1">WDBX memory &amp; retrieval</h3></div></div><p class="mt-2 text-sm leading-relaxed text-fg-muted">Durable records, searchable vectors and inspectable retrieval for applications that need continuity.</p><p class="mt-3 text-xs text-fg-subtle">Rust persistence, HNSW search and episode-store components are implemented.</p></article></a><a class="no-underline" href="/research/sea-overview"><article class="surface accent-edge p-6 surface-hover h-full"><div class="flex items-start justify-between gap-3"><div><p class="text-xs text-fg-subtle">sea</p><h3 class="font-display text-xl mt-1">SEA evidence selection</h3></div></div><p class="mt-2 text-sm leading-relaxed text-fg-muted">Select a bounded set of relevant records before assembling an assistant context.</p><p class="mt-3 text-xs text-fg-subtle">Eight-signal selection, task-specific scoring and bounded prompt assembly are implemented.</p></article></a><a class="no-underline" href="/research/gpu-overview"><article class="surface accent-edge p-6 surface-hover h-full"><div class="flex items-start justify-between gap-3"><div><p class="text-xs text-fg-subtle">gpu</p><h3 class="font-display text-xl mt-1">GPU &amp; compute</h3></div></div><p class="mt-2 text-sm leading-relaxed text-fg-muted">Inspect native vector-operation support and explicit CPU fallback.</p><p class="mt-3 text-xs text-fg-subtle">CPU vector operations and optional macOS Metal DOT dispatch are implemented.</p></article></a><a class="no-underline" href="/research/mcp-overview"><article class="surface accent-edge p-6 surface-hover h-full"><div class="flex items-start justify-between gap-3"><div><p class="text-xs text-fg-subtle">mcp</p><h3 class="font-display text-xl mt-1">MCP integrations</h3></div></div><p class="mt-2 text-sm leading-relaxed text-fg-muted">Expose bounded ABI operations through a documented tool interface.</p><p class="mt-3 text-xs text-fg-subtle">The twelve-tool stdio JSON-RPC contract is implemented.</p></article></a><a class="no-underline" href="/research/tui-overview"><article class="surface accent-edge p-6 surface-hover h-full"><div class="flex items-start justify-between gap-3"><div><p class="text-xs text-fg-subtle">tui</p><h3 class="font-display text-xl mt-1">TUI &amp; operator tools</h3></div></div><p class="mt-2 text-sm leading-relaxed text-fg-muted">Inspect local runtime state and explore session-based agent interactions.</p><p class="mt-3 text-xs text-fg-subtle">The diagnostics dashboard and agent REPL are implemented.</p></article></a></div></section><section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28"><header class="mb-12 max-w-3xl"><p class="eyebrow">Topics</p><h2 class="section-title mt-4 text-fg">Precise language. No borrowed benchmarks.</h2><p class="mt-5 max-w-2xl text-base leading-relaxed text-fg-muted sm:text-lg">If a number is not produced by a repository test or a documented artifact, it does not appear here.</p></header><div class="grid gap-4 md:grid-cols-2"><div><article class="surface accent-edge p-6 h-full"><div class="flex items-start justify-between gap-3"><div><h3 class="font-display text-xl">Memory architecture</h3></div><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-current" title="Present in public source and used as described."><span aria-hidden="true">●</span>Current</span></div><p class="mt-2 text-sm leading-relaxed text-fg-muted">Episodic records with WAL, MVCC, causal DAGs, and content addressing. Memory is a substrate, not a chat log with embeddings glued on. Applies to WDBX, ABI.</p></article></div><div><article class="surface accent-edge p-6 h-full"><div class="flex items-start justify-between gap-3"><div><h3 class="font-display text-xl">Retrieval</h3></div><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-partial" title="Implemented in part. Scope is named on the page."><span aria-hidden="true">◐</span>Partial</span></div><p class="mt-2 text-sm leading-relaxed text-fg-muted">WDBX implements exact and layered-HNSW retrieval with a pluggable scoring seam; evidence-weighted retrieval remains unimplemented. Applies to WDBX.</p></article></div><div><article class="surface accent-edge p-6 h-full"><div class="flex items-start justify-between gap-3"><div><h3 class="font-display text-xl">Distributed systems</h3></div><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-partial" title="Runnable or inspectable, not a product claim."><span aria-hidden="true">◌</span>Experimental</span></div><p class="mt-2 text-sm leading-relaxed text-fg-muted">Reference cluster replication and read repair are in source. They do not establish production sharding or hosted authority. Applies to WDBX.</p></article></div><div><article class="surface accent-edge p-6 h-full"><div class="flex items-start justify-between gap-3"><div><h3 class="font-display text-xl">Model orchestration</h3></div><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-partial" title="Implemented in part. Scope is named on the page."><span aria-hidden="true">◐</span>Partial</span></div><p class="mt-2 text-sm leading-relaxed text-fg-muted">Deterministic persona routing, template completion, and source-defined MCP tools. Model execution and quality require separate evidence from the selected runtime path. Applies to ABI.</p></article></div><div><article class="surface accent-edge p-6 h-full"><div class="flex items-start justify-between gap-3"><div><h3 class="font-display text-xl">Privacy and provider boundaries</h3></div><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-partial" title="Implemented in part. Scope is named on the page."><span aria-hidden="true">◐</span>Partial</span></div><p class="mt-2 text-sm leading-relaxed text-fg-muted">Browser workspace documents and vault notes use localStorage. Configured website model requests and Quasar generation have separate provider and data boundaries. Applies to Quesar, Abbey, ABI.</p></article></div><div><article class="surface accent-edge p-6 h-full"><div class="flex items-start justify-between gap-3"><div><h3 class="font-display text-xl">Provenance and trust</h3></div><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-partial" title="Implemented in part. Scope is named on the page."><span aria-hidden="true">◐</span>Partial</span></div><p class="mt-2 text-sm leading-relaxed text-fg-muted">Content addressing, signatures, and causal history expose record commitments and relationships. They do not establish the truth or evidential reliability of a record. Federation evidence is separately authorized. Applies to WDBX, Abbey.</p></article></div><div><article class="surface accent-edge p-6 h-full"><div class="flex items-start justify-between gap-3"><div><h3 class="font-display text-xl">Synchronization</h3></div><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-planned" title="Intent. Never presented as shipping."><span aria-hidden="true">○</span>Planned</span></div><p class="mt-2 text-sm leading-relaxed text-fg-muted">Synchronization requires separate implementation and signed-device qualification. The browser vault uses localStorage; the native CloudKit availability plugin does not implement vault synchronization. Applies to Quesar, mobile.</p></article></div><div><article class="surface accent-edge p-6 h-full"><div class="flex items-start justify-between gap-3"><div><h3 class="font-display text-xl">Interoperability</h3></div><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-planned" title="Founder or lab work. Not a Quesar product surface."><span aria-hidden="true">◆</span>Research</span></div><p class="mt-2 text-sm leading-relaxed text-fg-muted">Research scope: consistent product, persona, and claim-provenance vocabularies across integrations, with implementation and UI semantics evaluated separately. Applies to Quesar.</p></article></div></div></section><section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28"><header class="mb-12 max-w-3xl"><p class="eyebrow">Collection</p><h2 class="section-title mt-4 text-fg">Notes, overviews, and implementation guides.</h2></header><div c