.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon absolute inset-0 size-4 transition-[opacity,transform,filter] duration-250 ease-[cubic-bezier(0.22,1,0.36,1)] scale-100 opacity-100 blur-0" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path></svg></span></button><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="inline-flex size-11 items-center justify-center rounded-md text-fg lg:hidden" data-overlay-trigger="menu"><span class="sr-only">Open menu</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu size-5" aria-hidden="true"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"></path></svg></button></div></div></header><main id="main" tabindex="-1" class="flex-1"><!--$--><div class="border-b border-border"><div class="mx-auto max-w-6xl px-4 pt-16 pb-14 sm:px-6 sm:pt-24 sm:pb-20"><p class="eyebrow">Products</p><h1 class="mt-5 max-w-4xl font-display text-4xl leading-[1.02] tracking-tight text-fg sm:text-5xl lg:text-6xl">Find the right integration surface.</h1><p class="mt-6 max-w-[62ch] text-lg leading-8 text-fg-muted">Compare ABI, Abbey, WDBX, and Quasar by purpose, setup requirements, and implementation limits.</p></div></div><section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28"><p class="max-w-3xl text-base leading-relaxed text-fg-muted">The catalog describes local developer and document-workspace surfaces. Quasar is experimental and requires a separately running local service and provider configuration.</p><a href="https://github.com/donaldfilimon/quesar.cloud/blob/f3ccc082f72ef868ca3c3a60f332f7efe9cfe492/src/lib/mlai/categories/product-journeys.ts" target="_blank" rel="noreferrer" class="mt-4 inline-block text-sm text-accent underline underline-offset-4">Inspect the source behind this page</a></section><section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28"><div class="grid gap-4 md:grid-cols-2"><article class="surface accent-edge p-6 [--edge:var(--abi)] flex h-full flex-col"><p class="text-xs text-fg-subtle">Local developer framework</p><h2 class="mt-1 font-display text-3xl tracking-tight"><a class="text-fg no-underline hover:underline" href="/products/abi">ABI</a></h2><p class="mt-3 text-base leading-relaxed text-fg">Explore deterministic persona routing, template completion, and source-defined tools.</p><p class="mt-4 text-sm text-accent">Local developer framework</p><p class="mt-2 text-sm leading-relaxed text-fg-muted">Local deterministic routing and template completion do not establish foundation-model quality. External providers need separate configuration.</p><div class="mt-auto flex flex-wrap gap-5 pt-6 text-sm"><a class="text-fg underline underline-offset-4" href="/products/abi">Explore <!-- -->ABI</a><a class="text-accent underline underline-offset-4" href="/docs/getting-started">Setup documentation</a></div></article><article class="surface accent-edge p-6 [--edge:var(--abbey)] flex h-full flex-col"><p class="text-xs text-fg-subtle">Browser document preview</p><h2 class="mt-1 font-display text-3xl tracking-tight"><a class="text-fg no-underline hover:underline" href="/products/abbey">Abbey</a></h2><p class="mt-3 text-base leading-relaxed text-fg">Explore a browser document workspace and its optional configured server model-request path.</p><p class="mt-4 text-sm text-accent">Browser document preview</p><p class="mt-2 text-sm leading-relaxed text-fg-muted">Documents are stored in this browser&#x27;s localStorage. This preview does not establish setup or acceptance for a separate Abbey app.</p><div class="mt-auto flex flex-wrap gap-5 pt-6 text-sm"><a class="text-fg underline underline-offset-4" href="/products/abbey">Explore <!-- -->Abbey</a><a class="text-accent underline underline-offset-4" href="/workspace">Setup documentation</a></div></article><article class="surface accent-edge p-6 [--edge:var(--abi)] flex h-full flex-col"><p class="text-xs text-fg-subtle">Implemented Rust components for local integration</p><h2 class="mt-1 font-display text-3xl tracking-tight"><a class="text-fg no-underline hover:underline" href="/products/wdbx">WDBX</a></h2><p class="mt-3 text-base leading-relaxed text-fg">Store durable records and retrieve vectors with inspectable provenance.</p><p class="mt-4 text-sm text-accent">Implemented Rust components for local integration</p><p class="mt-2 text-sm leading-relaxed text-fg-muted">Storage integrity does not prove the truth of stored statements. The reference cluster protocol does not establish production multi-host operation or sharding.</p><div class="mt-auto flex flex-wrap gap-5 pt-6 text-sm"><a class="text-fg underline underline-offset-4" href="/products/wdbx">Explore <!-- -->WDBX</a><a class="text-accent underline underline-offset-4" href="/wdbx">Setup documentation</a></div></article><article class="surface accent-edge p-6 [--edge:var(--abi)] flex h-full flex-col"><p class="text-xs text-fg-subtle">Experimental local website builder with a browser client</p><h2 class="mt-1 font-display text-3xl tracking-tight"><a class="text-fg no-underline hover:underline" href="/products/quasar">Quasar</a></h2><p class="mt-3 text-base leading-relaxed text-fg">Generate a Next.js website and preview it on your own machine.</p><p class="mt-4 text-sm text-accent">Experimental local website builder with a browser client</p><p class="mt-2 text-sm leading-relaxed text-fg-muted">The service defaults to loopback and requires pairing for API operations. Generated project code runs as the operator. Live provider generation remains unverified; remote exposure requires operator-managed HTTPS and network opt-in.</p><div class="mt-auto flex flex-wrap gap-5 pt-6 text-sm"><a class="text-fg underline underline-offset-4" href="/products/quasar">Explore <!-- -->Quasar</a><a class="text-accent underline underline-offset-4" href="/quesar">Setup documentation</a></div></article></div><p class="mt-10 text-sm text-fg-muted">Choose by what you want to do:<!-- --> <a class="text-accent underline underline-offset-4" href="/get-started">Get started</a>. Inspect the supporting<!-- --> <a class="text-accent underline underline-offset-4" href="/research">research collection</a>.</p></section><section class="mx-auto max-w-6xl px-4 py-16 sm:px-6"><div class="flex flex-wrap gap-3"><a class="inline-flex items-center justify-center gap-2 border border-transparent font-medium whitespace-nowrap no-underline transition-[background-color,color,box-shadow,opacity,transform] duration-150 ease-out select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:pointer-events-none disabled:opacity-50 active:not-disabled:translate-y-px bg-primary text-primary-foreground hover:bg-primary/80 h-11 rounded-md px-4 text-sm" href="/contact">Discuss your project</a><a class="inline-flex items-center justify-center gap-2 border font-medium whitespace-nowrap no-underline transition-[background-color,color,box-shadow,opacity,transform] duration-150 ease-out select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:pointer-events-none disabled:opacity-50 active:not-disabled:translate-y-px border-border bg-card/80 text-foreground hover:bg-muted h-11 rounded-md px-4 text-sm" href="/architecture">Architecture</a><a class="inline-flex items-center justify-center gap-2 border font-medium whitespace-nowrap no-underline transition-[background-color,color,box-shadow,opacity,transform] duration-150 ease-out select-none focus-visible:outline-2 focus