neural-delay:1.22s;--neural-opacity:0.79"></circle><circle class="neural-field-node neural-field-node-inner" cx="258.61" cy="340.62" r="2.40" style="--neural-delay:1.34s;--neural-opacity:0.79"></circle><circle class="neural-field-node neural-field-node-inner" cx="218.45" cy="295.79" r="3.40" style="--neural-delay:1.21s;--neural-opacity:0.79"></circle><circle class="neural-field-node neural-field-node-inner" cx="201.32" cy="240.27" r="2.40" style="--neural-delay:1.31s;--neural-opacity:0.79"></circle><circle class="neural-field-node neural-field-node-inner" cx="233.31" cy="201.01" r="2.40" style="--neural-delay:1.25s;--neural-opacity:0.79"></circle><circle class="neural-field-node neural-field-node-inner" cx="297.11" cy="179.38" r="3.40" style="--neural-delay:1.33s;--neural-opacity:0.79"></circle><circle class="neural-field-node neural-field-node-inner" cx="349.25" cy="224.21" r="2.40" style="--neural-delay:1.28s;--neural-opacity:0.79"></circle></g><g class="neural-field-core"><circle class="neural-field-core-halo" cx="280" cy="260" r="18"></circle><circle class="neural-field-core-ring" cx="280" cy="260" r="10"></circle><circle cx="280" cy="260" r="4.5"></circle><circle class="neural-field-core-center" cx="279" cy="259" r="1.8"></circle></g></svg></div></div></div><div class="relative mx-auto flex max-w-6xl flex-wrap gap-x-8 gap-y-2 border-t border-white/10 px-4 py-5 text-sm sm:px-6"><a href="#ecosystem" class="vision-section-link inline-flex min-h-11 items-center">Explore the ecosystem ↓</a><a href="#film" class="vision-section-link inline-flex min-h-11 items-center">Watch the film ↓</a><a class="vision-section-link inline-flex min-h-11 items-center" href="/developers">Build with MLAI →</a></div></section><section class="vision-belief border-b border-border" aria-labelledby="belief-title"><div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-24"><h2 id="belief-title" class="font-display text-3xl leading-tight tracking-tight sm:text-4xl">AI should amplify human creativity.</h2><p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-fg-muted">Our direction is to help people learn, build, reason, and create while keeping human agency at the center.</p></div></section><section id="ecosystem" aria-labelledby="ecosystem-title" class="scroll-mt-20 border-b border-border"><div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-24"><header class="max-w-3xl"><p class="eyebrow">The MLAI ecosystem</p><h2 id="ecosystem-title" class="section-title mt-4">Distinct roles. One inspectable architecture.</h2><p class="mt-5 max-w-[52ch] text-base leading-relaxed text-fg-muted">Abbey, Aviva, and Abi are persona roles in ABI. WDBX supplies the memory substrate. Read each implementation boundary before integrating.</p></header><div class="min-w-0"><div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4"><article class="vision-product vision-product-abbey"><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-current" title="Present in public source and used as described."><span aria-hidden="true">●</span>Current</span><h3 class="mt-6 font-display text-3xl tracking-tight">Abbey</h3><p class="vision-product-role mt-2 text-sm font-medium">Human-facing companion</p><p class="mt-5 text-base leading-relaxed text-fg-muted">Designed for thoughtful teaching, creative work, and technical collaboration.</p><p class="mt-4 text-sm leading-relaxed text-fg-subtle">A persona contract; assistant behavior depends on the configured backend.</p><a class="mt-6 inline-flex min-h-11 items-center text-sm font-medium text-accent" href="/abbey">Explore <!-- -->Abbey<!-- --> →</a></article><article class="vision-product vision-product-aviva"><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-current" title="Present in public source and used as described."><span aria-hidden="true">●</span>Current</span><h3 class="mt-6 font-display text-3xl tracking-tight">Aviva</h3><p class="vision-product-role mt-2 text-sm font-medium">Direct expert mode</p><p class="mt-5 text-base leading-relaxed text-fg-muted">A response mode for concise, candid technical answers, concrete next actions, and explicit uncertainty.</p><p class="mt-4 text-sm leading-relaxed text-fg-subtle">A local persona profile; the role does not establish model quality.</p><a class="mt-6 inline-flex min-h-11 items-center text-sm font-medium text-accent" href="/abi">Explore <!-- -->Aviva<!-- --> →</a></article><article class="vision-product vision-product-abi"><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-partial" title="Implemented in part. Scope is named on the page."><span aria-hidden="true">◐</span>Partial</span><h3 class="mt-6 font-display text-3xl tracking-tight">Abi</h3><p class="vision-product-role mt-2 text-sm font-medium">Coordination layer</p><p class="mt-5 text-base leading-relaxed text-fg-muted">Evaluates intent, risk, context, and response style to select a persona or controlled blend.</p><p class="mt-4 text-sm leading-relaxed text-fg-subtle">Local routing and scheduler helpers; broader governance remains partial.</p><a class="mt-6 inline-flex min-h-11 items-center text-sm font-medium text-accent" href="/abi">Explore <!-- -->Abi<!-- --> →</a></article><article class="vision-product vision-product-wdbx"><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-current" title="Present in public source and used as described."><span aria-hidden="true">●</span>Current</span><h3 class="mt-6 font-display text-3xl tracking-tight">WDBX</h3><p class="vision-product-role mt-2 text-sm font-medium">Memory with provenance</p><p class="mt-5 text-base leading-relaxed text-fg-muted">Local Rust storage and retrieval components preserve durable records, vectors, and causal history.</p><p class="mt-4 text-sm leading-relaxed text-fg-subtle">Storage integrity does not make a statement true; production multi-host deployment is not established.</p><a class="mt-6 inline-flex min-h-11 items-center text-sm font-medium text-accent" href="/wdbx">Explore <!-- -->WDBX<!-- --> →</a></article></div><figure class="vision-architecture mt-12 rounded-lg border border-border bg-bg-elevated p-6 sm:p-8"><ol class="grid gap-6 sm:grid-cols-3" aria-label="Conceptual request flow"><li class="font-display text-xl"><span class="mb-2 block font-mono text-xs text-fg-subtle">0<!-- -->1</span>Your context</li><li class="font-display text-xl"><span class="mb-2 block font-mono text-xs text-fg-subtle">0<!-- -->2</span>ABI routing</li><li class="font-display text-xl"><span class="mb-2 block font-mono text-xs text-fg-subtle">0<!-- -->3</span>Selected persona</li></ol><div class="mt-6 border-t border-border pt-5 text-base"><span class="font-medium text-accent">WDBX</span><span class="ml-3 text-fg-muted">Context and storage · writes report their result</span></div><figcaption class="mt-4 text-sm leading-relaxed text-fg-subtle">Conceptual architecture. Persona roles share a runtime; this diagram does not establish separate models or hosted services.</figcaption><a class="mt-4 inline-flex min-h-11 items-center text-sm font-medium text-accent" href="/architecture">Inspect the architecture →</a><div class="mt-4 flex flex-wrap gap-x-5 gap-y-1" aria-label="Pinned ecosystem sources"><a href="https://github.com/donaldfilimon/abi/blob/80dfe079ebe7413a6815c2d564be1f0aaa901267/crates/abi-ai/src/identity.rs" class="inline-flex min-h-11 items-center text-xs text-accent underline underline-offset-4">ABI persona contracts</a><a href="https://github.com/donaldfilimon/abi/blob/80dfe079ebe7413a6815c2d564be1f0aaa901267/README.md" class="inline-flex min-h-11 items-center text-xs text-accent underline underline-offset-4">ABI setup and limits</a><a href="https://github.com/donaldfilimon/wdbx/blob/e45410356ceb4e96f0dc26a83b02e1c18cf94860/README.md" class="inline-flex min-h-11 items-center text-xs text-accent underline underline-offset-4">WDBX implementation</a><a href="https://github.com/donaldfilimon/NYON/blob/c3055747ce9d0352b2d1924a0a14eb12e930af43/README.md" class="inline-flex min-h-11 items-center text-xs text-accent underline underline-offset-4">NYON source</a></div></figure></div></div></section><section id="memory" aria-labelledby="memory-title" class="scroll-mt-20 border-b border-border"><div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-12 lg:gap-10"><header class="lg:col-span-5"><p class="eyebrow">Memory with provenance</p><h2 id="memory-title" class="section-title mt-4">An answer should carry its context.</h2><p class="mt-5 max-w-[52ch] text-base leading-relaxed text-fg-muted">Explore the sources, retrieval weights, and causal history behind a memory system. This example illustrates an inspectable trace.</p></header><div class="min-w-0 lg:col-span-7"><figure class="rounded-lg bg-bg-elevated shadow-border"><div class="border-b border-border px-5 py-5 sm:px-6"><p class="text-sm text-fg-muted">Answer</p><p class="mt-1.5 font-display text-xl leading-snug tracking-tight sm:text-2xl">Keep the German customer records in-region.</p></div><div class="relative px-5 py-5 sm:px-6"><span class="chain-draw absolute top-7 bottom-9 left-[1.6rem] w-0.5 bg-accent sm:left-[1.85rem]" aria-hidden="true"></span><p class="pl-7 text-sm text-fg-muted">Because of, strongest first</p><ol class="relative mt-3 grid gap-4"><li class="grid grid-cols-[1.25rem_minmax(0,1fr)] gap-2.5"><span class="relative mt-1.5 size-2.5 justify-self-center rounded-full ring-4 ring-bg-elevated bg-persona-aviva" aria-hidden="true"></span><div class="min-w-0"><div class="flex items-baseline justify-between gap-3"><span class="truncate font-mono text-xs text-fg-muted">runbook/retention-policy.md</span><span class="font-mono text-xs tabular-nums text-persona-aviva">0.94</span></div><p class="mt-1 text-base leading-snug text-fg">EU records stay in-region; no cross-border egress.</p><div class="mt-2 h-1 rounded-full bg-muted" aria-hidden="true"><i class="block h-full rounded-full bg-persona-aviva" style="width:94%"></i></div><p class="mt-1.5 font-mono text-2xs text-fg-subtle">blk_8f21c4<!-- --> <span aria-hidden="true">←</span><span class="sr-only">parent</span> <!-- -->a17d<!-- --> <span class="sr-only">, via <!-- -->Aviva</span></p></div></li><li class="grid grid-cols-[1.25rem_minmax(0,1fr)] gap-2.5"><span class="relative mt-1.5 size-2.5 justify-self-center rounded-full ring-4 ring-bg-elevated bg-persona-abi" aria-hidden="true"></span><div class="min-w-0"><div class="flex items-baseline justify-between gap-3"><span class="truncate font-mono text-xs text-fg-muted">contracts/dpa-2026.pdf</span><span class="font-mono text-xs tabular-nums text-persona-abi">0.71</span></div><p class="mt-1 text-base leading-snug text-fg">Processor may not sub-process without written notice.</p><div class="mt-2 h-1 rounded-full bg-muted" aria-hidden="true"><i class="block h-full rounded-full bg-persona-abi" style="width:71%"></i></div><p class="mt-1.5 font-mono text-2xs text-fg-subtle">blk_8f21b0<!-- --> <span aria-hidden="true">←</span><span class="sr-only">parent</span> <!-- -->6c02<!-- --> <span class="sr-only">, via <!-- -->Abi</span></p></div></li><li class="grid grid-cols-[1.25rem_minmax(0,1fr)] gap-2.5"><span class="relative mt-1.5 size-2.5 justify-self-center rounded-full ring-4 ring-bg-elevated bg-persona-abbey" aria-hidden="true"></span><div class="min-w-0"><div class="flex items-baseline justify-between gap-3"><span class="truncate font-mono text-xs text-fg-muted">thread/eng-platform#412</span><span class="font-mono text-xs tabular-nums text-persona-abbey">0.38</span></div><p class="mt-1 text-base leading-snug text-fg">Earlier draft, superseded and kept for audit.</p><div class="mt-2 h-1 rounded-full bg-muted" aria-hidden="true"><i class="block h-full rounded-full bg-persona-abbey" style="width:38%"></i></div><p class="mt-1.5 font-mono text-2xs text-fg-subtle">blk_8f2196<!-- --> <span aria-hidden="true">←</span><span class="sr-only">parent</span> <!-- -->3e9f<!-- --> <span class="sr-only">, via <!-- -->Abbey</span></p></div></li></ol></div><figcaption class="border-t border-border px-5 py-3 text-xs text-fg-subtle sm:px-6">Illustrative trace. Bar length is the retrieval weight; each block names its parent hash.</figcaption></figure><a class="mt-5 inline-flex min-h-11 items-center text-accent" href="/docs/wdbx">Read the WDBX guide →</a></div></div></section><section id="developers" aria-labelledby="developers-title" class="scroll-mt-20 border-b border-border"><div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-12 lg:gap-10"><header class="lg:col-span-5"><p class="eyebrow">For builders</p><h2 id="developers-title" class="section-title mt-4">Start with the source.</h2><p class="mt-5 max-w-[52ch] text-base leading-relaxed text-fg-muted">Explore ABI’s Rust framework, local CLI, and MCP contracts. Follow the setup and verification guidance before connecting models, tools, or memory.</p></header><div class="min-w-0 lg:col-span-7"><div class="vision-code rounded-lg border border-border bg-bg-elevated p-5 sm:p-7"><p class="mb-5 font-mono text-xs text-fg-subtle">Local CLI example — requires ABI source setup</p><pre class="overflow-x-auto text-sm leading-7"><code>./tools/cargo.sh build -p abi-cli
+./target/debug/abi agent plan &quot;stage a safe WDBX refactor&quot;</code></pre></div><p class="mt-5 text-sm leading-relaxed text-fg-muted">Local framework and contracts. Hosted Quesar APIs and platform SDKs are not published.</p><div class="mt-6 flex flex-wrap gap-x-6 gap-y-2"><a class="inline-flex min-h-11 items-center text-accent" href="/developers">Read the developer path →</a><a class="inline-flex min-h-11 items-center text-accent" href="/docs/getting-started">Open setup guide →</a></div></div></div></section><section id="research" aria-labelledby="research-title" class="scroll-mt-20 border-b border-border"><div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-12 lg:gap-10"><header class="lg:col-span-5"><p class="eyebrow">Research and simulation</p><h2 id="research-title" class="section-title mt-4">Explore the ideas. Inspect the evidence.</h2><p class="mt-5 max-w-[52ch] text-base leading-relaxed text-fg-muted">Read source-backed work on memory, retrieval, model orchestration, and provenance, with implementation status beside the research.</p></header><div class="min-w-0 lg:col-span-7"><div class="border-t border-border pt-6"><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-partial" title="Actively changing. Do not treat as stable."><span aria-hidden="true">◦</span>In development</span><h3 class="mt-4 font-display text-2xl">NYON: deterministic worlds</h3><p class="mt-3 text-base leading-relaxed text-fg-muted">A Rust strategy game with a separate offline Galaxy Workshop sandbox.</p><p class="mt-4 text-sm leading-relaxed text-fg-subtle">Workshop development and desktop/browser qualification remain in progress. NYON is a related source project.</p><a class="mt-5 inline-flex min-h-11 items-center text-accent" href="/source/nyon">Explore NYON’s source →</a></div><a class="mt-4 inline-flex min-h-11 items-center text-accent" href="/research">Visit the research library →</a></div></div></section><section id="engagements" aria-labelledby="engagements-title" class="scroll-mt-20 border-b border-border"><div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-24"><header class="max-w-3xl"><p class="eyebrow">For organizations · Services</p><h2 id="engagements-title" class="section-title mt-4">Choose the next engineering decision.</h2><p class="mt-5 max-w-[52ch] text-base leading-relaxed text-fg-muted">Define a private AI engagement around retrieval, tool permissions, deployment topology, and evaluation. Scope and acceptance criteria are agreed for each project.</p></header><div class="min-w-0"><div class="grid gap-8 md:grid-cols-3"><article class="border-t border-border pt-6"><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-planned" title="Intent. Never presented as shipping."><span aria-hidden="true">○</span>Planned</span><h3 class="mt-4 font-display text-2xl">Assess the system</h3><p class="mt-3 text-base leading-relaxed text-fg-muted">Scope an audit of workflows, data paths, and approval gates. Use workshops and runtime profiling to turn open questions into a risk register, architecture decisions, and an optimization backlog.</p><ul class="mt-5 space-y-2 text-sm text-fg-muted"><li>Autonomy Readiness Audit</li><li>Executive &amp; Engineering Workshops</li><li>Model &amp; Runtime Optimization</li></ul><a class="mt-6 inline-block text-accent" href="/services">Explore services →</a></article><article class="border-t border-border pt-6"><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-planned" title="Intent. Never presented as shipping."><span aria-hidden="true">○</span>Planned</span><h3 class="mt-4 font-display text-2xl">Build a bounded workflow</h3><p class="mt-3 text-base leading-relaxed text-fg-muted">Scope retrieval architecture, agent roles, and deployment topology. Translate research into an API contract and test plan, with the data boundary and tool permissions defined before implementation.</p><ul class="mt-5 space-y-2 text-sm text-fg-muted"><li>WDBX Retrieval Architecture</li><li>Multi-Agent Orchestration</li><li>Private AI Deployment</li><li>Research Translation</li></ul><a class="mt-6 inline-block text-accent" href="/services">Explore services →</a></article><article class="border-t border-border pt-6"><span class="inline-flex items-center gap-1.5 text-xs font-medium text-status-planned" title="Intent. Never presented as shipping."><span aria-hidden="true">○</span>Planned</span><h3 class="mt-4 font-display text-2xl">Harden the release path</h3><p class="mt-3 text-base leading-relaxed text-fg-muted">Scope policy checks, audit events, red-team scenarios, and regression evaluation. Agree on release gates and a rollback plan before expanding autonomy.</p><ul class="mt-5 space-y-2 text-sm text-fg-muted"><li>Safety &amp; Compliance Layering</li><li>Continuous Evaluation Systems</li></ul><a class="mt-6 inline-block text-accent" href="/services">Explore services →</a></article></div></div></div></section><section id="evidence" aria-labelledby="evidence-title" class="scroll-mt-20 border-b border-border"><div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-12 lg:gap-10"><header class="lg:col-span-5"><p class="eyebrow">Evidence</p><h2 id="evidence-title" class="section-title mt-4">Inspect the work before choosing a path.</h2></header><div class="min-w-0 lg:col-span-7"><ul class="divide-y divide-border border-y border-border"><li class="py-5"><a class="font-display text-xl text-accent" href="/architecture">Inspect the architecture</a><p class="mt-2 text-base leading-relaxed text-fg-muted">Read the runtime layers alongside their implementation limits.</p></li><li class="py-5"><a class="font-display text-xl text-accent" href="/developers">Read the source</a><p class="mt-2 text-base leading-relaxed text-fg-muted">Follow repository links and setup guidance for a technical review.</p></li><li class="py-5"><a class="font-display text-xl text-accent" href="/products">Compare product availability</a><p class="mt-2 text-base leading-relaxed text-fg-muted">Check each product&#x27;s setup requirements and stated limitations.</p></li><li class="py-5"><a class="font-display text-xl text-accent" href="/docs">Open the documentation</a><p class="mt-2 text-base leading-relaxed text-fg-muted">Start with the guides, then follow the source behind the behavior.</p></li></ul><p class="mt-6 text-sm leading-relaxed text-fg-muted">The catalog describes local developer and document-workspace surfaces. Quasar is experimental and requires a separately running local service and provider configuration.</p></div></div></section><section id="film" aria-labelledby="film-title" class="scroll-mt-20 border-b border-border"><div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-12 lg:gap-10"><header class="lg:col-span-5"><p class="eyebrow">The film</p><h2 id="film-title" class="section-title mt-4">See the direction. Inspect the evidence.</h2><p class="mt-5 max-w-[52ch] text-base leading-relaxed text-fg-muted">The films carry vision and roadmap context; they do not establish benchmarks or shipped capability.</p></header><div class="min-w-0 lg:col-span-7"><figure class="overflow-hidden rounded-xl border border-border bg-card"><div class="relative bg-black" aria-keyshortcuts="Space K ArrowLeft ArrowRight F M C"><video class="aspect-video w-full object-cover" poster="/media/quesar-trailer.webp" muted="" playsInline="" preload="metadata" aria-label="Quesar film, The mark"><source src="/media/quesar-trailer.webm" type="video/webm; codecs=&quot;av01.0.05M.08&quot;"/><source src="/media/quesar-trailer.mp4" type="video/mp4"/><track kind="descriptions" srcLang="en" label="English descriptions" src="/media/mark.vtt"/></video><button type="button" class="group absolute inset-0 grid place-items-center text-white" aria-label="Play trailer"><span class="grid size-12 place-items-center rounded-full bg-black/55 backdrop-blur-sm s